# Xponent — environment template. Copy to .env and adjust for local use.
# These are DEV defaults only; use real secrets outside local development.

# --- Primary OLTP database (host access; containers use the service DSNs) ---
PRIMARY_DB_HOST=localhost
PRIMARY_DB_PORT=5432
PRIMARY_DB_NAME=primary_db
PRIMARY_SUPERUSER_URL=postgresql://postgres:primary_password@localhost:5432/primary_db
# CDC worker connects with the least-privilege replication role:
PRIMARY_DB_URL=postgresql://replication_reader:rep_pass@localhost:5432/primary_db

# --- Summary / rollup database ----------------------------------------------
SUMMARY_DB_PORT=5433
SUMMARY_DB_NAME=agg_db
# Worker writes as the owner/superuser (bypasses RLS to write all tenants):
SUMMARY_DB_OWNER_URL=postgresql://agg_user:agg_password@localhost:5433/agg_db
# API reads as the non-superuser reader (RLS-constrained — NEVER use the owner here):
SUMMARY_DB_URL=postgresql://agg_reader:agg_reader_pass@localhost:5433/agg_db

# --- Cache / coordination ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- API ---------------------------------------------------------------------
# Auth posture per decision D3: JWT dropped. Dev mode accepts X-Dev-Tenant-ID.
AUTH_DEV_MODE=true

# --- CDC ---------------------------------------------------------------------
CDC_SLOT_NAME=agg_slot
CDC_PUBLICATION=agg_layer_pub
